{
  "nuoyan_space_fall": {
    "vertexShader": "shaders/dual_vector_foil/space_fall.vertex",
    "fragmentShader": "shaders/dual_vector_foil/space_fall.fragment",
    "vertexFields": [
      {
        "field": "Position"
      },
      {
        "field": "UV0"
      }
    ],
    "samplerStates": [
      {
        "samplerIndex": 0,
        "textureWrap": "Clamp",
        "textureFilter": "Bilinear"
      },
      {
        "samplerIndex": 2,
        "textureWrap": "Clamp",
        "textureFilter": "Point"
      }
    ],
    "states": [
      "DisableDepthTest"
    ],
    "msaaSupport": "Both"
  }
}
