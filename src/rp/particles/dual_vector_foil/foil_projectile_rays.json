{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "nuoyan:foil_projectile_rays",
            "basic_render_parameters": {
                "material": "particles_add",
                "texture": "textures/dual_vector_foil/projectile_ray"
            }
        },
        "components": {
            "minecraft:emitter_local_space": {
                "position": false,
                "rotation": false
            },
            "minecraft:emitter_rate_steady": {
                "spawn_rate": 90,
                "max_particles": 96
            },
            "minecraft:emitter_lifetime_looping": {
                "active_time": 1.0,
                "sleep_time": 0.0
            },
            "minecraft:emitter_shape_sphere": {
                "radius": 0.12,
                "surface_only": true,
                "direction": "outwards"
            },
            "minecraft:particle_initial_speed": "5 + variable.particle_random_1 * 3",
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": "0.45 + variable.particle_random_2 * 0.3"
            },
            "minecraft:particle_motion_dynamic": {
                "linear_acceleration": [0, 0, 0],
                "linear_drag_coefficient": 1.2
            },
            "minecraft:particle_appearance_billboard": {
                "size": [
                    "0.018 + variable.particle_random_3 * 0.018",
                    "0.3 + variable.particle_age * 0.9"
                ],
                "facing_camera_mode": "direction_y",
                "direction": {
                    "mode": "derive_from_velocity",
                    "min_speed_threshold": 0.01
                },
                "uv": {
                    "texture_width": 32,
                    "texture_height": 128,
                    "uv": [0, 0],
                    "uv_size": [32, 128]
                }
            },
            "minecraft:particle_appearance_tinting": {
                "color": [
                    0.65,
                    0.88,
                    1.0,
                    "math.min(1, variable.particle_age * 18) * math.min(1, (variable.particle_lifetime - variable.particle_age) * 5)"
                ]
            }
        }
    }
}
