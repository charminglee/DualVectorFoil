{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "nuoyan:cataclysm_shards",
            "basic_render_parameters": {
                "material": "particles_blend",
                "texture": "textures/dual_vector_foil/shard"
            }
        },
        "components": {
            "minecraft:emitter_rate_instant": {
                "num_particles": 480
            },
            "minecraft:emitter_lifetime_once": {
                "active_time": 0.05
            },
            "minecraft:emitter_shape_point": {},
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": 4.8
            },
            "minecraft:particle_motion_parametric": {
                "relative_position": [
                    "(variable.particle_random_1 - 0.5) * 200",
                    "(6 + variable.particle_random_2 * 95) * (1 - math.pow(math.min(1, variable.particle_age / (variable.particle_lifetime * 0.75)), 2))",
                    "(variable.particle_random_3 - 0.5) * 200"
                ],
                "rotation": "variable.particle_random_2 * 360 + (variable.particle_random_3 - 0.5) * 70 * math.min(variable.particle_age, variable.particle_lifetime * 0.75)"
            },
            "minecraft:particle_appearance_billboard": {
                "size": [
                    "0.7 + variable.particle_random_2 * 4.5",
                    "0.3 + variable.particle_random_3 * 2.8"
                ],
                "facing_camera_mode": "direction_z",
                "uv": {
                    "texture_width": 32,
                    "texture_height": 32,
                    "uv": [0, 0],
                    "uv_size": [32, 32]
                },
                "direction": {
                    "mode": "custom_direction",
                    "custom_direction": [
                        "math.sin(70 * (1 - math.min(1, variable.particle_age / (variable.particle_lifetime * 0.75)))) * math.cos(variable.particle_random_1 * 360)",
                        "math.cos(70 * (1 - math.min(1, variable.particle_age / (variable.particle_lifetime * 0.75))))",
                        "math.sin(70 * (1 - math.min(1, variable.particle_age / (variable.particle_lifetime * 0.75)))) * math.sin(variable.particle_random_1 * 360)"
                    ]
                }
            },
            "minecraft:particle_appearance_tinting": {
                "color": [
                    0.35,
                    0.8,
                    1,
                    "math.min(1, variable.particle_age * 5) * math.min(1, (variable.particle_lifetime - variable.particle_age) * 2)"
                ]
            }
        }
    }
}
