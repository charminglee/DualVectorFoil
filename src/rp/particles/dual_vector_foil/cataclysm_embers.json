{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "nuoyan:cataclysm_embers",
            "basic_render_parameters": {
                "material": "particles_blend",
                "texture": "textures/dual_vector_foil/shard"
            }
        },
        "components": {
            "minecraft:emitter_rate_instant": {
                "num_particles": 180
            },
            "minecraft:emitter_lifetime_once": {
                "active_time": 0.05
            },
            "minecraft:emitter_shape_point": {},
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": 4.8
            },
            "minecraft:particle_motion_parametric": {
                "relative_position": [
                    "(variable.particle_random_1 - 0.5) * 180 * (1 - math.pow((variable.particle_age / variable.particle_lifetime), 3))",
                    "variable.particle_random_2 * 4 + 30 * math.sin(180 * (variable.particle_age / variable.particle_lifetime))",
                    "(variable.particle_random_3 - 0.5) * 180 * (1 - math.pow((variable.particle_age / variable.particle_lifetime), 3))"
                ]
            },
            "minecraft:particle_initial_spin": {
                "rotation": "variable.particle_random_2 * 360",
                "rotation_rate": "(variable.particle_random_3 - 0.5) * 70"
            },
            "minecraft:particle_appearance_billboard": {
                "size": [0.22, 1.6],
                "facing_camera_mode": "lookat_xyz",
                "uv": {
                    "texture_width": 32,
                    "texture_height": 32,
                    "uv": [0, 0],
                    "uv_size": [32, 32]
                }
            },
            "minecraft:particle_appearance_tinting": {
                "color": [
                    0.35,
                    0.8,
                    1,
                    "math.min(1, variable.particle_age * 5) * math.min(1, (variable.particle_lifetime - variable.particle_age) * 2)"
                ]
            }
        }
    }
}
